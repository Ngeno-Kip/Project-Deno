# Copy this file outside the public document root and set DENO_CONFIG_FILE
# to its absolute path, or define these values in the hosting control panel.
APP_ENV=production
# Set true only when a trusted reverse proxy terminates HTTPS and the origin
# server is not directly reachable by untrusted clients.
DENO_TRUST_PROXY_HTTPS=false
DENO_DB_HOST=your-database-host
DENO_DB_PORT=3306
DENO_DB_NAME=your-database-name
DENO_DB_USER=your-database-user
DENO_DB_PASSWORD=replace-with-a-strong-password
# Optional: use a private writable directory if the host's PHP session path
# is not writable. Relative paths are resolved from the project root.
# DENO_SESSION_SAVE_PATH=storage/sessions
PROJECT_DENO_MAIL_FROM=your-sender@example.com
# Generate a random 32+ character key for first-admin setup, then remove it
# from the server after the first admin account is created.
PROJECT_DENO_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional: set an absolute path outside the public document root.
# PROJECT_DENO_LOG_FILE=/path/to/private/project-deno.log
# Optional Telegram notifications:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
